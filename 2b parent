#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <sys/types.h>
#include <sys/wait.h>

void sort(int arr[], int n) {
    for (int i = 0; i < n - 1; i++)
        for (int j = i + 1; j < n; j++)
            if (arr[i] > arr[j]) {
                int temp = arr[i];
                arr[i] = arr[j];
                arr[j] = temp;
            }
}

int main() {
    int arr[16];
    printf("Enter 16 integers:\n");
    for (int i = 0; i < 16; i++) {
        scanf("%d", &arr[i]);
    }

    sort(arr, 16);
    printf("Sorted array:\n");
    for (int i = 0; i < 16; i++) {
        printf("%d ", arr[i]);
    }
    printf("\n");

    pid_t pid = fork();

    if (pid == 0) {
        

        
        char *args[18]; 
        args[0] = "./child"; 

        for (int i = 0; i < 16; i++) {
            args[i + 1] = (char *)malloc(10);
            sprintf(args[i + 1], "%d", arr[i]);
        }

        args[17] = NULL; 

        // Call execve
        char *envp[] = { NULL }; 
        execve("./child", args, envp);

        perror("execve failed");
    } else {
       
        wait(NULL);
    }

    return 0;
}
