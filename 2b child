#include <stdio.h>
#include <stdlib.h>

int binarySearch(int arr[], int size, int target) {
    int low = 0, high = size - 1;

    while (low <= high) {
        int mid = (low + high) / 2;
        if (arr[mid] == target)
            return mid;
        else if (arr[mid] < target)
            low = mid + 1;
        else
            high = mid - 1;
    }

    return -1;
}

int main() {
    FILE *f = fopen("array.txt", "r");
    if (f == NULL) {
        perror("Failed to open file");
        return 1;
    }

    int arr[16];
    for (int i = 0; i < 16; i++) {
        if (fscanf(f, "%d", &arr[i]) != 1) {
            printf("Failed to read all numbers from file.\n");
            fclose(f);
            return 1;
        }
    }
    fclose(f);

    int target;
    printf("Enter number to search: ");
    scanf("%d", &target);

    int index = binarySearch(arr, 16, target);
    if (index != -1)
        printf("Element %d found at index %d\n", target, index);
    else
        printf("Element %d not found.\n", target);

    return 0;
}
